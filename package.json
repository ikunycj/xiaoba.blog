{
  "type": "module",
  "scripts": {
    "blog:index": "node scripts/generate-blog-index.mjs",
    "i": "npm install",
    "docs:dev": "npm run blog:index && vitepress dev --port 5174",
    "docs:build": "npm run blog:index && vitepress build",
    "docs:preview": "vitepress preview --port 4174",
    "images:prepare": "node scripts/prepare-images.mjs",
    "images:push": "node scripts/push-image-repo.mjs",
    "images:sync": "npm run images:prepare && npm run images:push",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test:images": "node --test scripts/image-pipeline.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "markdown-it-mathjax3": "^4.3.2",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "vitepress": "^1.6.4",
    "vitepress-sidebar": "^1.36.1",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0"
  }
